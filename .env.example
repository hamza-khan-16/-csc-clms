# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Your Supabase project URL
SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase project ID (the subdomain of your project URL)
SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PROJECT_ID=your-project-id

# Publishable (anon) key — safe to expose to the browser
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Service role key — SECRET, server-side only, never expose to browser
# Used by server functions (login, register, admin actions)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Groq (AI features) ────────────────────────────────────────────────────────
# Free API key from https://console.groq.com (no credit card required)
# Server-side only — never exposed to the browser (no VITE_ prefix)
# Used for: LeaveBot chatbot + text content moderation
GROQ_API_KEY=gsk_...

# Secret for accessing debug/admin API endpoints (generate a random string)
DEBUG_SECRET=your-random-secret-here

# Required to access /api/push-debug and /api/push-sync-all (admin-only endpoints)
DEBUG_SECRET=your-random-secret-here
